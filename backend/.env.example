DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional when R2_ACCOUNT_ID is provided; normally https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: default model retained from the existing app.
GEMINI_MODEL=gemini-2.5-flash
# Optional local-only executable paths. Leave unset in Docker (tools are on PATH).
TESSERACT_PATH=
POPPLER_PATH=
