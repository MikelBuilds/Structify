# ===========================
# Structify .gitignore
# ===========================

# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
*.pyc

# Virtual Environment
venv/
.venv/
backend/venv/
env/

# ---------------------------
# Environment Variables
# ---------------------------
.env
*.env
.env.*
!.env.example
backend/.env
frontend/.env

# ---------------------------
# IDE
# ---------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------
# OS Files
# ---------------------------
.DS_Store
Thumbs.db

# ---------------------------
# Logs
# ---------------------------
*.log
logs/

# ---------------------------
# Python Cache
# ---------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------
# Build
# ---------------------------
build/
dist/

# ---------------------------
# Node
# ---------------------------
node_modules/
frontend/node_modules/
frontend/dist/

# ---------------------------
# Uploads
# ---------------------------
backend/uploads/originals/*
backend/uploads/processed/*

# Keep folders in Git
!backend/uploads/originals/.gitkeep
!backend/uploads/processed/.gitkeep

# ---------------------------
# OCR Debug Images
# ---------------------------
debug.png

# ---------------------------
# SQLite
# ---------------------------
*.db
*.sqlite3

# ---------------------------
# Jupyter
# ---------------------------
.ipynb_checkpoints/

# ---------------------------
# Temporary Files
# ---------------------------
*.tmp
*.bak
*.cache

# ---------------------------
# Repomix Output
# ---------------------------
repomix-output.md